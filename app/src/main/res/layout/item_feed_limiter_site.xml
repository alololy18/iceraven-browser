<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSiteName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Instagram" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUsage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:textSize="13sp"
            tools:text="12 of 30 posts · 20 of 45 min" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#1F000000" />

        <LinearLayout
            android:id="@+id/rowPostCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/feed_limiter_cap_post" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchPostCap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnPostMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_down" />

            <TextView
                android:id="@+id/tvPostLimit"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                tools:text="30" />

            <Button
                android:id="@+id/btnPostPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_up" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPostCountdown"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            tools:text="Post cap countdown: 15 min" />

        <LinearLayout
            android:id="@+id/rowTimerCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/feed_limiter_timer_cap_label" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchTimerCap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnTimerMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_down" />

            <TextView
                android:id="@+id/tvTimerLimit"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                tools:text="45" />

            <Button
                android:id="@+id/btnTimerPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_up" />
        </LinearLayout>

        <Button
            android:id="@+id/btnTimerCountdown"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            tools:text="Timer cap countdown: 15 min" />

        <LinearLayout
            android:id="@+id/rowVideoCap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/feed_limiter_video_cap_label" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVideoCap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnVideoMinus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_down" />

            <TextView
                android:id="@+id/tvVideoLimit"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold"
                tools:text="5" />

            <Button
                android:id="@+id/btnVideoPlus"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/feed_limiter_step_up" />
        </LinearLayout>

        <Button
            android:id="@+id/btnVideoCountdown"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingHorizontal="0dp"
            android:textAllCaps="false"
            android:textSize="13sp"
            tools:text="Video cap countdown: 15 min" />

        <CheckBox
            android:id="@+id/checkDesaturate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/feed_limiter_desaturate_site" />

        <Button
            android:id="@+id/btnRemoveSite"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingHorizontal="0dp"
            android:text="@string/feed_limiter_remove_site"
            android:textAllCaps="false" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
