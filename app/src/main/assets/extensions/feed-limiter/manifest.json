{
  "manifest_version": 2,
  "name": "Feed Limiter (Phase 1 dev build)",
  "version": "0.3.0",
  "description": "Core post-cap/timer-cap counting and blocking logic for Instagram, X, TikTok, Facebook, Reddit, LinkedIn, and YouTube Shorts. Phase 2: native settings UI + friction/cooldown gate, synced to the background script via native messaging.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "nativeMessaging",
    "geckoViewAddons",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.facebook.com/*",
    "*://*.reddit.com/*",
    "*://*.linkedin.com/*",
    "*://*.youtube.com/*"
  ],
  "background": {
    "scripts": ["config.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/instagram.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/x.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/tiktok.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/facebook.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/reddit.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/linkedin.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/shorts/*"],
      "js": ["content-scripts/badge.js", "content-scripts/youtube-shorts.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["interstitial.html", "config.js"],
  "browser_specific_settings": {
    "gecko": {
      "id": "feed-limiter-dev@personal.local",
      "strict_min_version": "109.0"
    }
  }
}
