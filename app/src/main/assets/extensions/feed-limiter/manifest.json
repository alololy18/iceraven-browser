{
  "manifest_version": 2,
  "name": "Feed Limiter",
  "version": "0.4.0",
  "description": "Caps posts and time on feed sites, regular YouTube and user-added sites, then blocks them until local midnight. Settings live in the browser's native Feed Limiter screen.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "nativeMessaging",
    "geckoViewAddons",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["config.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/visibility.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content-scripts/instagram.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content-scripts/x.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content-scripts/tiktok.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content-scripts/facebook.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["content-scripts/reddit.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content-scripts/linkedin.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/shorts/*"],
      "js": ["content-scripts/youtube-shorts.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content-scripts/youtube-watch.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["interstitial.html", "config.js", "images/activities/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "feed-limiter-dev@personal.local",
      "strict_min_version": "109.0"
    }
  }
}
