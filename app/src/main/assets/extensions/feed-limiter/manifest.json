{
  "manifest_version": 2,
  "name": "Feed Limiter (Phase 1 dev build)",
  "version": "0.1.0",
  "description": "Core post-cap/timer-cap counting and blocking logic for Instagram and X. Phase 1: sideload-only, no native settings UI, no friction/cooldown gate yet, no custom sites or YouTube.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "alarms",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*"
  ],
  "background": {
    "scripts": ["config.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/instagram.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["*://*.x.com/*", "*://*.twitter.com/*"],
      "js": ["content-scripts/badge.js", "content-scripts/x.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": ["interstitial.html", "config.js"],
  "browser_specific_settings": {
    "gecko": {
      "id": "feed-limiter-dev@personal.local",
      "strict_min_version": "109.0"
    }
  }
}
